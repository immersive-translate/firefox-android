{
  "manifest_version": 2,
  "name": "messaging",
  "version": "1.0",
  "description": "javascript messaging bridge web extension.",
  "allowed_extensions": ["pengxiao18@163.com"],
  "browser_specific_settings": {
    "gecko": {
      "id": "pengxiao18@163.com"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    "bridge.js"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "nativeMessaging",
    "geckoViewAddons",
    "activeTab",
    "tabs",
    "<all_urls>"
  ],
  "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'"
}
